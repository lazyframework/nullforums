using UnityEngine;
using UnityEngine.InputSystem; // Wajib ditambahkan

public class CarJoystickController : MonoBehaviour
{
    [Header("Joystick Input")]
    public FixedJoystick joystick; 

    [Header("Car Settings")]
    public float moveSpeed = 15f;    
    public float turnSpeed = 100f;   

    private Rigidbody rb;

    void Start()
    {
        rb = GetComponent<Rigidbody>();
    }

    void FixedUpdate()
    {
        float moveInput = 0f;
        float turnInput = 0f;

        // 1. Cek Input dari Joystick (Jika ada)
        if (joystick != null && (joystick.Horizontal != 0 || joystick.Vertical != 0))
        {
            moveInput = joystick.Vertical;
            turnInput = joystick.Horizontal;
        }
        // 2. Cek Input dari Keyboard (WASD / Panah)
        else if (Keyboard.current != null)
        {
            if (Keyboard.current.wKey.isPressed || Keyboard.current.upArrowKey.isPressed) moveInput = 1f;
            if (Keyboard.current.sKey.isPressed || Keyboard.current.downArrowKey.isPressed) moveInput = -1f;
            
            if (Keyboard.current.aKey.isPressed || Keyboard.current.leftArrowKey.isPressed) turnInput = -1f;
            if (Keyboard.current.dKey.isPressed || Keyboard.current.rightArrowKey.isPressed) turnInput = 1f;
        }

        // 3. Fisika Mobil
        // Maju/Mundur
        Vector3 moveDirection = transform.forward * moveInput * moveSpeed;
        rb.linearVelocity = new Vector3(moveDirection.x, rb.linearVelocity.y, moveDirection.z);

        // Belok
        if (Mathf.Abs(moveInput) > 0.1f)
        {
            Quaternion turnRotation = Quaternion.Euler(0f, turnInput * turnSpeed * Time.fixedDeltaTime, 0f);
            rb.MoveRotation(rb.rotation * turnRotation);
        }
    }
}
