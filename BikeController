using UnityEngine;
using UnityEngine.InputSystem;

public class BikeController : MonoBehaviour
{
    [Header("Bike Settings")]
    public float moveSpeed = 10f;
    public float turnSpeed = 80f;
    public float pedalRotationSpeed = 300f; // Kecepatan putar pedal

    private Rigidbody rb;
    private Animator playerAnimator; 
    private PedalRotator pedalScript; // Referensi ke script pedal

    void Start()
    {
        // Ambil komponen Rigidbody
        rb = GetComponent<Rigidbody>();
        
        // Kunci rotasi sepeda agar tidak jatuh/miring ke samping
        rb.constraints = RigidbodyConstraints.FreezeRotationX | RigidbodyConstraints.FreezeRotationZ;
        
        // Cari komponen Animator pada karakter (karena karakter sudah jadi anak sepeda)
        playerAnimator = GetComponentInChildren<Animator>();

        // Cari script PedalRotator yang menempel pada objek Cranks/Pedals
        pedalScript = GetComponentInChildren<PedalRotator>();
    }

    void FixedUpdate()
    {
        float moveInput = 0f;
        float turnInput = 0f;

        // Baca Input Keyboard (WASD)
        if (Keyboard.current != null)
        {
            if (Keyboard.current.wKey.isPressed) moveInput = 1f;
            if (Keyboard.current.sKey.isPressed) moveInput = -1f;
            if (Keyboard.current.aKey.isPressed) turnInput = -1f;
            if (Keyboard.current.dKey.isPressed) turnInput = 1f;
        }

        // --- 1. PERGERAKAN SEPEDA ---
        // Menggunakan linearVelocity agar pergerakan halus dan tidak menembus objek
        Vector3 moveDirection = transform.forward * moveInput * moveSpeed;
        rb.linearVelocity = new Vector3(moveDirection.x, rb.linearVelocity.y, moveDirection.z);

        // --- 2. BELOK SEPEDA ---
        if (Mathf.Abs(moveInput) > 0.1f)
        {
            Quaternion turnRotation = Quaternion.Euler(0f, turnInput * turnSpeed * Time.fixedDeltaTime, 0f);
            rb.MoveRotation(rb.rotation * turnRotation);
        }

        // --- 3. ANIMASI KAKI KARAKTER ---
        if (playerAnimator != null)
        {
            // Menggunakan animasi lari (Speed) agar kaki bergerak seperti mengayuh
            float animSpeed = Mathf.Abs(moveInput);
            playerAnimator.SetFloat("Speed", animSpeed * 2f); 
        }

        // --- 4. PUTARAN PEDAL SEPEDA ---
        if (pedalScript != null)
        {
            // Kirim nilai kecepatan ke script pedal agar ikut berputar sesuai arah maju/mundur
            pedalScript.SetSpeed(moveInput * pedalRotationSpeed);
        }
    }
}
